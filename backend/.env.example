# Copy to .env if you want to override defaults.
# Go server port (embedded server / standalone API)
PORT=8080
# Postgres DSN matching docker-compose.yml
DATABASE_URL=postgres://app:app@localhost:5432/appdb?sslmode=disable
# Nuxt dev port
NUXT_PORT=3000

# Redis configuration (optional, used for token revocation)
REDIS_URL=localhost:6379

# JWT secret for auth token signing
JWT_SECRET=logitech-default-development-secret-key-32bytes!!

# System Administrator credentials (configured in env)
# Can create owner and manager accounts
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminpassword123
ADMIN_EMAIL=admin@logitech.example
