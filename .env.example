# ---------------------------------------------------------------------------
# Frontend (Nuxt) — public values, safe to expose to the browser
# ---------------------------------------------------------------------------
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_API_BASE=http://localhost:8080/api/v1
# Base domain used to resolve company branding from subdomains.
NUXT_PUBLIC_APP_DOMAIN=localhost
NUXT_PUBLIC_DEMO_URL=/book-demo
# Full WhatsApp click-to-chat URL (https://wa.me/<number>). Leave empty until confirmed.
NUXT_PUBLIC_WHATSAPP_URL=https://wa.me/+2348061977760
# Public browser token from Mapbox. Required for delivery address map previews.
NUXT_PUBLIC_MAPBOX_ACCESS_TOKEN=
# Cloudinary unsigned upload configuration for optional package photos.
NUXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NUXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=

# ---------------------------------------------------------------------------
# Backend (Go API)
# ---------------------------------------------------------------------------
APP_ENV=development
PORT=8080
APP_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DATABASE_URL=postgres://app:app@localhost:5432/appdb?sslmode=disable
# BOL's Redis runs on host port 6380 to avoid other local Redis instances.
REDIS_URL=redis://localhost:6380/0

# Must be at least 32 characters; required in production.
JWT_SECRET=dev-only-jwt-secret-change-before-production
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=false

# Google OAuth for customer and provider login/sign-up. Platform administrator
# accounts are rejected by the API. Create an OAuth 2.0 Client ID (Web
# application) in Google Cloud Console and add GOOGLE_REDIRECT_URI as an
# authorized redirect URI. The redirect must exactly match this value.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback

# Bootstrap platform super administrator. Created at API startup when the
# account does not exist yet; an existing account is never overwritten.
# Change this password before deploying. Sign in at /admin/login.
SUPER_ADMIN_EMAIL=admin@bol.example
SUPER_ADMIN_PASSWORD=change-me-before-production
# Public key is only needed for browser-side Plunk event tracking.
PLUNK_PUBLIC_KEY=
PLUNK_SECRET_KEY=
PLUNK_FROM_EMAIL=admin@bol.com

# Meta WhatsApp Cloud API. Create and approve an authentication template that
# accepts one text parameter containing the verification code.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_OTP_TEMPLATE=bol_phone_verification
WHATSAPP_TEMPLATE_LANGUAGE=en_US

# Local image uploads for company logos, covers and favicons.
UPLOAD_DIR=uploads
# Public origin used to build uploaded image URLs.
API_PUBLIC_URL=http://localhost:8080
# Tenant domain used by backend host resolution (e.g. app.example.com).
APP_DOMAIN=localhost
